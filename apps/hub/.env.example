# Saajha web — environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini API key (https://aistudio.google.com/apikey). Required for /api/diagnose;
# without it the route returns HTTP 503 (no canned diagnosis).
GEMINI_API_KEY=

# Primary model for diagnosis + advisory.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used only after the primary fails twice with a 429/503-type error.
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Text-to-speech model for spoken advisories.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
